{
  "priority": 1,
  "request": {
    "method": "POST",
    "urlPath": "/v19.0/test-phone-id/messages",
    "headers": {"Authorization": {"equalTo": "Bearer test-access-token"}},
    "bodyPatterns": [
      {"matchesJsonPath": "$.to", "equalTo": "919876543210"},
      {"matchesJsonPath": "$.type", "equalTo": "interactive"},
      {"matchesJsonPath": "$.interactive.type", "equalTo": "button"},
      {"matchesJsonPath": "$.interactive.body.text", "contains": "Should I process this?"},
      {"matchesJsonPath": "$.interactive.action.buttons[0].reply.title", "equalTo": "Yes"},
      {"matchesJsonPath": "$.interactive.action.buttons[0].reply.id", "matches": "audio_confirm:[0-9a-f-]{36}"},
      {"matchesJsonPath": "$.interactive.action.buttons[1].reply.title", "equalTo": "Retry"},
      {"matchesJsonPath": "$.interactive.action.buttons[1].reply.id", "matches": "audio_retry:[0-9a-f-]{36}"}
    ]
  },
  "response": {
    "status": 200,
    "headers": {"Content-Type": "application/json"},
    "jsonBody": {"messages": [{"id": "wamid.test-confirmation"}]}
  }
}
