{
  "priority": 1,
  "request": {
    "method": "POST",
    "urlPath": "/v19.0/test-phone-id/messages",
    "headers": {"Authorization": {"equalTo": "Bearer test-access-token"}},
    "bodyPatterns": [
      {"matchesJsonPath": "$.to", "equalTo": "919876543210"},
      {"matchesJsonPath": "$.type", "equalTo": "text"},
      {"matchesJsonPath": "$.text.body", "equalTo": "Saved successfully."}
    ]
  },
  "response": {
    "status": 200,
    "headers": {"Content-Type": "application/json"},
    "jsonBody": {"messages": [{"id": "wamid.test-reply"}]}
  }
}
