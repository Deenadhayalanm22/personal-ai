{"type":"frame-snapshot","snapshot":{"callId":"call@23","phase":"after","pageId":"page@8d24545ee9f7fd6a602063a9a9fa5c75","frameId":"frame@a7c5472701ff245359bfc33e5e8f14d0","frameUrl":"http://localhost:4173/dashboard?month=2026-04","doctype":"html","html":["HTML",{"lang":"en"},["HEAD",{},["BASE",{"href":"http://localhost:4173/dashboard?month=2026-04"}],"\n    ","\n\n    ",["META",{"charset":"utf-8"}],"\n    ",["META",{"name":"viewport","content":"width=device-width, initial-scale=1.0"}],"\n    ",["META",{"name":"description","content":"Secure monthly expense dashboard"}],"\n    ",["TITLE",{},"Expense AI"],"\n  ",["STYLE",{},"@import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@600;700;800&display=swap');\n\n:root{font-family:'DM Sans',sans-serif;color:#1e2822;background:#f5f3ec;font-synthesis:none;text-rendering:optimizeLegibility;--ink:#1e2822;--muted:#727a74;--green:#22684f;--green-2:#4f8f70;--lime:#dceca7;--line:#deddd5;--paper:#fffefa;--wash:#f0efe8;--red:#9b4b3e;--shadow:0 18px 50px rgba(28,42,34,.08)}\n\n*{box-sizing:border-box}\n\nhtml{scroll-behavior:smooth}\n\nbody{margin:0;min-width:320px;min-height:100vh;background:radial-gradient(circle at 50% -12rem,#e8f1d1 0,transparent 34rem),#f5f3ec;color:var(--ink)}\n\nbutton,input{font:inherit}\n\nbutton{cursor:pointer}\n\nbutton:disabled{cursor:not-allowed;opacity:.42}\n\nh1,h2,h3,p{margin-top:0}\n\nbutton:focus-visible,a:focus-visible,input:focus-visible{outline:3px solid #91ad48;outline-offset:3px}\n\n.portal-topbar{position:sticky;top:0;z-index:20;display:flex;align-items:center;justify-content:space-between;gap:16px;min-height:68px;padding:0 max(18px,calc((100vw - 560px)/2));border-bottom:1px solid rgba(30,40,34,.1);background:rgba(255,254,250,.86);backdrop-filter:blur(16px)}\n\n.wordmark{display:flex;align-items:center;gap:9px;color:var(--ink);font:800 15px Manrope;text-decoration:none}\n\n.wordmark>span{display:grid;place-items:center;width:32px;height:32px;border-radius:50%;background:var(--ink);color:var(--lime)}\n\n.month-switcher{display:flex;align-items:center;border:1px solid var(--line);border-radius:12px;background:var(--paper);overflow:hidden}\n\n.month-switcher button{width:34px;height:36px;border:0;background:transparent;color:var(--muted)}\n\n.month-switcher input{width:132px;height:36px;padding:0 6px;border:0;border-inline:1px solid var(--line);background:transparent;color:var(--ink);font-size:11px}\n\n.story-shell{width:min(100% - 28px,520px);margin:0 auto;padding:34px 0 112px}\n\n.app-heading{display:flex;align-items:flex-start;justify-content:space-between;gap:18px;margin:2px 2px 28px}\n\n.micro-label{margin:0 0 7px;color:var(--green);font-size:10px;font-weight:800;letter-spacing:.14em;text-transform:uppercase}\n\n.app-heading h1,.story-detail h1{margin:0;font:800 clamp(31px,8vw,44px)/1.04 Manrope;letter-spacing:-.045em}\n\n.app-heading p:last-child{margin:10px 0 0;color:var(--muted);font-size:13px;line-height:1.5}\n\n.profile-button{display:grid;place-items:center;flex:0 0 auto;width:42px;height:42px;border:1px solid var(--line);border-radius:50%;background:var(--paper);color:var(--green);font-weight:800}\n\n.month-card,.activity-panel,.profile-card{padding:22px;border:1px solid var(--line);border-radius:22px;background:rgba(255,254,250,.94);box-shadow:var(--shadow)}\n\n.section-title{display:flex;align-items:flex-start;justify-content:space-between;gap:14px}\n\n.section-title h2{margin:0;font:700 19px Manrope}\n\n.section-title>span{color:var(--muted);font-size:10px}\n\n.month-summary{display:grid;grid-template-columns:1.25fr 1fr 1fr;gap:12px;margin:24px 0 18px;padding:17px 0;border-block:1px solid var(--line)}\n\n.month-summary span,.recent-transaction span,.transaction-row span,.evidence-row span{display:block;color:var(--muted);font-size:10px}\n\n.month-summary strong{display:block;margin-top:5px;font:800 16px Manrope}\n\n.weekdays,.calendar{display:grid;grid-template-columns:repeat(7,1fr);gap:5px}\n\n.weekdays{margin-bottom:6px;color:var(--muted);font-size:9px;text-align:center}\n\n.calendar button{aspect-ratio:1;border:0;border-radius:7px;background:#ebeae4;color:var(--ink);font-size:11px}\n\n.calendar button.level-1,.legend .level-1{background:#dcecdf}\n\n.calendar button.level-2,.legend .level-2{background:#afd1ba}\n\n.calendar button.level-3,.legend .level-3{background:#70a787;color:#fff}\n\n.calendar button.level-4,.legend .level-4{background:#276a50;color:#fff}\n\n.calendar button.future{border:1px dashed #d6d5cf;background:transparent;color:#aaa}\n\n.calendar button.selected{box-shadow:0 0 0 2px var(--paper),0 0 0 4px var(--green)}\n\n.legend{display:flex;align-items:center;justify-content:center;gap:9px;margin-top:8px;color:var(--muted);font-size:9px}\n\n.legend>div{display:flex;gap:3px}\n\n.legend i{display:block;width:10px;height:10px;border-radius:3px;background:#ebeae4}\n\n.day-selection{display:grid;grid-template-columns:1fr auto;gap:12px;align-items:center;margin-top:18px;padding-top:17px;border-top:1px solid var(--line)}\n\n.day-selection strong,.day-selection span{display:block}\n\n.day-selection span{margin-top:3px;color:var(--muted);font-size:10px}\n\n.day-selection p{margin:6px 0 0;font-size:11px}\n\n.day-selection button{padding:9px 12px;border:1px solid var(--line);border-radius:10px;background:var(--paper);color:var(--green);font-weight:800}\n\n.recent-block{margin:24px 2px}\n\n.recent-head{display:flex;align-items:center;justify-content:space-between;margin-bottom:4px}\n\n.recent-head span{font-size:10px;color:var(--muted)}\n\n.recent-head button{width:34px;height:34px;border:0;background:transparent;color:var(--green)}\n\n.recent-transaction{display:flex;align-items:center;justify-content:space-between;gap:16px;padding:17px 0;border-bottom:1px solid var(--line)}\n\n.recent-transaction strong{display:block;margin-bottom:5px}\n\n.recent-transaction>b{white-space:nowrap;font:800 15px Manrope}\n\n.stories-section{margin-top:28px}\n\n.story-card{display:block;width:100%;margin-top:12px;padding:19px;border:1px solid var(--line);border-radius:18px;background:rgba(255,254,250,.94);color:var(--ink);text-align:left;box-shadow:0 8px 24px rgba(28,42,34,.05)}\n\n.story-card.new-story{border-color:#c9d7b7;background:linear-gradient(145deg,#fffefa,#f2f7e7)}\n\n.story-card>div{display:flex;justify-content:space-between;gap:15px;align-items:flex-start}\n\n.story-card h3{margin:10px 0 0;font:700 18px/1.25 Manrope}\n\n.story-card p{margin:12px 0 11px;color:var(--muted);font-size:12px;line-height:1.55}\n\n.story-card small{color:var(--green);font-weight:700}\n\n.story-badge{display:inline-flex;padding:5px 8px;border-radius:999px;background:#e7efda;color:var(--green);font-size:9px;font-weight:800;text-transform:uppercase;letter-spacing:.07em}\n\n.empty-state{padding:38px 22px;text-align:center;border:1px dashed #c9cac2;border-radius:18px;color:var(--muted)}\n\n.empty-state>span{display:grid;place-items:center;width:42px;height:42px;margin:0 auto 15px;border-radius:50%;background:#e7efda;color:var(--green);font-size:20px}\n\n.empty-state h2{margin-bottom:8px;color:var(--ink);font:700 18px Manrope}\n\n.empty-state p{margin:0;font-size:12px;line-height:1.55}\n\n.story-empty{margin-top:14px}\n\n.story-rail-section{margin:0 0 22px}\n\n.story-rail-section .section-title{padding:0 2px}\n\n.story-rail{display:flex;gap:16px;margin:16px -14px 0;padding:2px 14px 11px;overflow-x:auto;scroll-snap-type:x proximity;scrollbar-width:none}\n\n.story-rail::-webkit-scrollbar{display:none}\n\n.story-orb{display:grid;justify-items:center;flex:0 0 70px;gap:5px;padding:0;border:0;background:transparent;color:var(--ink);scroll-snap-align:start;text-align:center}\n\n.story-ring{display:grid;place-items:center;width:62px;height:62px;border-radius:50%;padding:4px}\n\n.story-orb-inner{display:grid;place-items:center;width:100%;height:100%;border:2px solid var(--paper);border-radius:50%;background:#edf3e3;color:var(--green);font:800 22px Manrope}\n\n.story-orb.viewed .story-orb-inner{background:#e4e8e3;color:#496052}\n\n.story-orb strong{width:78px;overflow:hidden;font-size:10px;line-height:1.2;text-overflow:ellipsis;white-space:nowrap}\n\n.story-orb small{color:var(--muted);font-size:9px}\n\n.story-rail-empty{width:100%;padding:17px;border:1px dashed #c9cac2;border-radius:14px;color:var(--muted);font-size:11px;line-height:1.45}\n\n.story-orb:focus-visible{border-radius:12px}\n\n.top-greeting{width:min(100% - 28px,520px);margin:24px auto 0}\n\n.top-greeting .app-heading{margin:0}\n\n.top-greeting .notice{margin-top:14px}\n\n.top-story-rail{width:min(100% - 28px,520px);margin:22px auto 0;padding:18px 18px 7px;border:1px solid #c9d7b7;border-radius:21px;background:linear-gradient(145deg,#fffefa,#edf4df);box-shadow:0 10px 28px rgba(50,79,43,.06)}\n\n.top-story-rail .story-rail-section{margin-bottom:0}\n\n.workspace-divider{display:flex;align-items:center;gap:10px;width:min(100% - 28px,520px);margin:25px auto 0;color:var(--muted);font-size:9px;font-weight:800;letter-spacing:.13em}\n\n.workspace-divider::before,.workspace-divider::after{height:1px;flex:1;background:var(--line);content:''}\n\n.workspace-divider span{white-space:nowrap}\n\n.chapter-shelf{display:flex;gap:11px;margin:16px -18px 0;padding:1px 18px 13px;overflow-x:auto;scroll-snap-type:x proximity;scrollbar-width:none}\n\n.chapter-shelf::-webkit-scrollbar{display:none}\n\n.money-chapter{position:relative;display:flex;flex:0 0 146px;flex-direction:column;align-items:flex-start;min-height:168px;padding:14px;border:1px solid #d9d9d0;border-radius:15px;background:#fffefa;color:var(--ink);overflow:hidden;scroll-snap-align:start;text-align:left;box-shadow:0 6px 17px rgba(42,55,38,.05)}\n\n.money-chapter::before{position:absolute;top:0;left:0;width:100%;height:5px;background:#b99f46;content:''}\n\n.money-chapter.calm::before{background:#4f8f70}\n\n.money-chapter.focus::before{background:#22684f}\n\n.money-chapter.alert::before{background:#b7604e}\n\n.money-chapter.action::before{background:#75a56f}\n\n.money-chapter.viewed{background:#f0f0ea;color:#59625c;box-shadow:none}\n\n.money-chapter.viewed::before{background:#6d786f}\n\n.chapter-month{margin-top:4px;color:#7b7352;font-size:9px;font-weight:800;letter-spacing:.13em}\n\n.money-chapter.calm .chapter-month,.money-chapter.focus .chapter-month{color:var(--green)}\n\n.money-chapter.alert .chapter-month{color:var(--red)}\n\n.chapter-marks{display:flex;gap:4px;margin:10px 0 17px}\n\n.chapter-marks i{display:block;width:18px;height:3px;border-radius:99px;background:#d9d7c8}\n\n.money-chapter.warm .chapter-marks i:first-child,.money-chapter.focus .chapter-marks i:first-child,.money-chapter.calm .chapter-marks i:first-child,.money-chapter.alert .chapter-marks i:first-child{background:var(--green)}\n\n.money-chapter.alert .chapter-marks i:first-child{background:var(--red)}\n\n.money-chapter.viewed .chapter-marks i{background:#89928b}\n\n.money-chapter strong{min-height:34px;font:800 18px/1.08 Manrope}\n\n.money-chapter b{display:block;margin-top:auto;font:800 24px/1 Manrope;letter-spacing:-.04em}\n\n.money-chapter small{display:block;width:100%;margin-top:8px;overflow:hidden;color:var(--muted);font-size:9px;line-height:1.25;text-overflow:ellipsis;white-space:nowrap}\n\n.money-chapter:focus-visible{outline-offset:3px}\n\n.bottom-nav{position:fixed;z-index:18;left:50%;bottom:16px;display:grid;grid-template-columns:repeat(4,1fr);width:min(calc(100% - 28px),500px);padding:7px;border:1px solid rgba(30,40,34,.11);border-radius:18px;background:rgba(255,254,250,.92);box-shadow:0 18px 55px rgba(21,35,27,.18);backdrop-filter:blur(16px);transform:translateX(-50%)}\n\n.bottom-nav button{display:grid;gap:3px;place-items:center;min-height:49px;border:0;border-radius:12px;background:transparent;color:var(--muted);font-size:10px;font-weight:700}\n\n.bottom-nav button>span{font-size:18px}\n\n.bottom-nav button.active{background:#edf3e3;color:var(--green)}\n\n.back-button{margin-bottom:25px;padding:8px 0;border:0;background:transparent;color:var(--green);font-weight:700}\n\n.story-detail h1{margin-bottom:27px}\n\n.evidence-visual{display:grid;gap:18px;padding:22px;border:1px dashed #c8c9c1;border-radius:16px}\n\n.evidence-visual>div{display:grid;grid-template-columns:1fr auto;gap:8px 12px}\n\n.evidence-visual span{color:var(--muted);font-size:11px}\n\n.evidence-visual i{grid-column:1/-1;display:block;height:8px;border-radius:999px;background:var(--green)}\n\n.detail-copy{margin:24px 0;color:#465049;font-size:14px;line-height:1.7}\n\n.evidence-list{margin-top:9px}\n\n.evidence-row{display:flex;align-items:center;justify-content:space-between;gap:15px;padding:16px 2px;border-bottom:1px solid var(--line)}\n\n.evidence-row strong{display:block;margin-bottom:5px}\n\n.evidence-row>b{white-space:nowrap}\n\n.context-card{margin-top:26px;padding:20px;border-radius:16px;background:#edf3e3}\n\n.context-card p:last-child{margin:0;font-size:13px;line-height:1.65}\n\n.story-reader-backdrop{position:fixed;z-index:80;inset:0;display:grid;place-items:center;padding:22px;background:rgba(26,37,29,.28);backdrop-filter:blur(10px);animation:reader-in .2s ease-out}\n\n.story-detail{width:min(100%,520px);max-height:calc(100vh - 44px);padding:26px;overflow-y:auto;border:1px solid rgba(255,255,255,.72);border-radius:26px;background:var(--paper);box-shadow:0 30px 100px rgba(10,20,14,.32)}\n\n@keyframes reader-in{from{opacity:0}to{opacity:1}}\n\n.story-updated{margin-top:6px;color:var(--green);font-size:9px;font-weight:800}\n\n.observation-deck{margin-top:14px}\n\n.story-slide.observation-card{min-height:0;padding:25px;background:linear-gradient(150deg,#f5f8e9,#edf4e3);border-color:#cbdcc1;box-shadow:none}\n\n.observation-card .slide-eyebrow{margin-bottom:15px;color:var(--green)}\n\n.observation-card h1{font-size:clamp(27px,7vw,36px);margin-bottom:13px}\n\n.observation-card .story-action{margin-top:20px}\n\n.contribution-bar{height:8px;margin:2px 0 20px;overflow:hidden;border-radius:99px;background:#dbe8d4}\n\n.contribution-bar i{display:block;height:100%;border-radius:inherit;background:var(--green)}\n\n.observation-components{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin-top:22px}\n\n.observation-components>div,.observation-parts>div{padding:11px;border-radius:12px;background:rgba(255,255,255,.7)}\n\n.observation-components span,.observation-components strong,.observation-parts span,.observation-parts strong{display:block}\n\n.observation-components span,.observation-parts span{color:var(--muted);font-size:9px;font-weight:700;line-height:1.3}\n\n.observation-components strong,.observation-parts strong{margin-top:5px;color:var(--green);font:800 15px Manrope}\n\n.observation-parts{display:grid;gap:7px;margin-top:12px}\n\n.observation-parts>div{display:flex;align-items:center;justify-content:space-between}\n\n.observation-parts strong{margin-top:0}\n\n.report-classification{margin-top:18px;padding:0;border:0;background:transparent;color:var(--green);font-size:11px;font-weight:800}\n\n.discretionary-preview{border-color:#d4cfae;background:linear-gradient(145deg,#fffefa,#faf5df)}\n\n.story-card-metric{display:block!important;margin-top:15px;padding:11px 12px;border-radius:12px;background:rgba(255,255,255,.65)}\n\n.story-card-metric strong,.story-card-metric span{display:block}\n\n.story-card-metric strong{font:800 21px Manrope;color:#504821}\n\n.story-card-metric span{margin-top:2px;color:#746f58;font-size:10px}\n\n.story-deck{margin-top:20px}\n\n.story-progress{display:flex;gap:6px;margin-bottom:12px}\n\n.story-progress i{display:block;flex:1;height:4px;border-radius:99px;background:#e4e2d7}\n\n.story-progress i.active{background:var(--green)}\n\n.story-slide{min-height:424px;padding:27px;border:1px solid #d8d5c4;border-radius:25px;background:linear-gradient(150deg,#fffcf1,#f6edc5);box-shadow:0 16px 40px rgba(63,57,28,.11)}\n\n.story-slide.compare{background:linear-gradient(150deg,#f5f8e9,#e2efd1);border-color:#cbdcc1}\n\n.story-slide.action{background:linear-gradient(150deg,#e5f1df,#cbe6ca);border-color:#b9d6b4}\n\n.slide-eyebrow{margin:0 0 25px;color:#6c6339;font-size:10px;font-weight:800;letter-spacing:.12em;text-transform:uppercase}\n\n.compare .slide-eyebrow,.action .slide-eyebrow{color:var(--green)}\n\n.story-amount{margin-bottom:26px}\n\n.story-amount span,.story-amount strong{display:block}\n\n.story-amount span,.spend-compare span{color:#706846;font-size:11px;font-weight:700}\n\n.story-amount strong{margin-top:2px;font:800 clamp(44px,12vw,62px)/1 Manrope;color:#504821;letter-spacing:-.06em}\n\n.story-slide h1{max-width:390px;margin:0 0 15px;font:800 clamp(29px,8vw,40px)/1.08 Manrope;letter-spacing:-.05em}\n\n.story-slide p:not(.slide-eyebrow){max-width:380px;margin:0;color:#4d5547;font-size:14px;line-height:1.65}\n\n.spend-compare{display:grid;grid-template-columns:1fr 1fr;gap:9px;margin-bottom:27px}\n\n.spend-compare>div{padding:13px;border-radius:14px;background:rgba(255,255,255,.68)}\n\n.spend-compare strong{display:block;margin-top:4px;font:800 21px Manrope;color:var(--green)}\n\n.story-action{margin-top:28px;padding:12px 15px;border:0;border-radius:11px;background:var(--green);color:#fff;font-size:12px;font-weight:800}\n\n.story-deck-controls{display:flex;align-items:center;justify-content:space-between;gap:8px;margin-top:13px}\n\n.story-deck-controls button{min-width:72px;padding:10px;border:1px solid var(--line);border-radius:10px;background:var(--paper);color:var(--green);font-size:11px;font-weight:800}\n\n.story-deck-controls span{color:var(--muted);font-size:10px;font-weight:700}\n\n.story-evidence{margin-top:22px;padding-top:18px;border-top:1px solid var(--line)}\n\n.story-evidence summary{color:var(--green);font-size:12px;font-weight:800;cursor:pointer}\n\n.story-evidence .evidence-list{margin-top:10px}\n\n.deck-preview{border-color:#c9d7b7;background:linear-gradient(145deg,#fffefa,#f2f7e7)}\n\n.story-slide.deck-theme-CALM_CONTEXT{background:linear-gradient(150deg,#f5f8e9,#e2efd1);border-color:#cbdcc1}\n\n.story-slide.deck-theme-FOCUS{background:linear-gradient(150deg,#e9f2ef,#cfe6dc);border-color:#bad8ca}\n\n.story-slide.deck-theme-HIGH_SPEND_ALERT{background:linear-gradient(150deg,#fff1e8,#f5d7c7);border-color:#e4c3b4}\n\n.story-slide.deck-theme-POSITIVE_ACTION{background:linear-gradient(150deg,#e5f1df,#cbe6ca);border-color:#b9d6b4}\n\n.deck-theme-CALM_CONTEXT .slide-eyebrow,.deck-theme-FOCUS .slide-eyebrow,.deck-theme-POSITIVE_ACTION .slide-eyebrow{color:var(--green)}\n\n.deck-theme-HIGH_SPEND_ALERT .slide-eyebrow{color:var(--red)}\n\n.deck-theme-FOCUS .story-amount strong{color:var(--green)}\n\n.deck-theme-HIGH_SPEND_ALERT .story-amount strong{color:var(--red)}\n\n.story-evidence-sheet h2{margin:0;font:800 24px Manrope}\n\n.evidence-total{margin:7px 0 14px;color:var(--green);font-size:12px;font-weight:800}\n\n.evidence-backdrop{z-index:90}\n\n.activity-panel{box-shadow:none}\n\n.tag-filter{padding-bottom:18px;border-bottom:1px solid var(--line)}\n\n.filter-head{display:flex;justify-content:space-between;align-items:center;margin-bottom:10px}\n\n.filter-head button,.text-link{border:0;background:transparent;color:var(--green);font-size:11px;font-weight:700}\n\n.tag-filter>input{width:100%;padding:11px;border:1px solid var(--line);border-radius:10px;background:#fff}\n\n.tag-pills{display:flex;flex-wrap:wrap;gap:6px;margin-top:9px}\n\n.tag-pills button{padding:6px 9px;border:1px solid #cdd8ca;border-radius:999px;background:#fff;color:var(--green);font-size:10px}\n\n.tag-pills button.active{background:var(--green);color:#fff}\n\n.transaction-row{display:grid;grid-template-columns:1fr auto;gap:14px;padding:19px 0;border-bottom:1px solid var(--line)}\n\n.transaction-row strong{display:block;margin-bottom:5px}\n\n.transaction-row p{margin:8px 0 0;color:#4d5650;font-size:12px;line-height:1.45}\n\n.transaction-row>div:last-child{text-align:right}\n\n.transaction-row b{display:block;white-space:nowrap}\n\n.transaction-row button{margin:10px 0 0 10px;padding:0;border:0;background:transparent;color:var(--green);font-size:10px;font-weight:700}\n\n.transaction-row button.delete-link{color:var(--red)}\n\n.wide-button{width:100%;margin-top:18px;padding:12px;border:0;border-radius:11px;background:var(--green);color:#fff;font-weight:800}\n\n.profile-card{text-align:center}\n\n.profile-mark{display:grid;place-items:center;width:64px;height:64px;margin:0 auto 14px;border-radius:50%;background:var(--ink);color:var(--lime);font:800 24px Manrope}\n\n.profile-card p{color:var(--muted);font-size:13px}\n\n.notice{display:flex;justify-content:space-between;gap:15px;margin-bottom:16px;padding:13px;border:1px solid #e1c8be;border-radius:12px;background:#fff0e9;color:var(--red);font-size:12px}\n\n.notice button{border:0;background:transparent;color:inherit}\n\n.modal-backdrop{position:fixed;inset:0;z-index:50;display:grid;place-items:center;padding:18px;background:rgba(18,29,22,.58);backdrop-filter:blur(5px)}\n\n.modal{position:relative;width:min(100%,470px);max-height:calc(100vh - 36px);padding:27px;overflow-y:auto;border-radius:22px;background:var(--paper);box-shadow:0 30px 100px rgba(10,20,14,.45)}\n\n.modal h2{font:800 25px Manrope}\n\n.close{position:absolute;right:18px;top:15px;border:0;background:transparent;color:var(--muted);font-size:26px}\n\n.original,.source-note{margin-bottom:16px;padding:14px;border-radius:12px;background:var(--wash)}\n\n.original small,.source-note span,.source-note small{display:block;color:var(--muted);font-size:10px}\n\n.original p{margin:6px 0 0;font-size:12px}\n\n.source-note strong{display:block;margin:4px 0}\n\n.modal>label{display:grid;gap:7px;margin-top:14px;font-size:12px;font-weight:700}\n\n.modal input{width:100%;padding:12px;border:1px solid var(--line);border-radius:10px;background:#fff;color:var(--ink)}\n\n.tag-selector{margin:18px 0 0;padding:0;border:0}\n\n.tag-selector legend{font-size:12px;font-weight:700}\n\n.tag-options{display:grid;max-height:140px;margin-top:7px;padding:5px;overflow:auto;border:1px solid var(--line);border-radius:10px;background:#fff}\n\n.tag-options label{display:flex;align-items:center;gap:9px;padding:8px}\n\n.tag-options input{width:auto}\n\n.create-tag{display:grid;grid-template-columns:1fr auto;gap:7px;margin-top:8px}\n\n.create-tag button{border:0;border-radius:10px;background:var(--green);color:#fff;font-weight:800}\n\n.modal-actions{display:flex;justify-content:flex-end;gap:9px;margin-top:22px}\n\n.modal-actions button{padding:11px 14px;border:0;border-radius:10px;font-weight:800}\n\n.secondary{background:#ecebe5;color:var(--ink)}\n\n.primary{background:var(--green);color:#fff}\n\n.form-error{color:var(--red);font-size:11px}\n\n.toast{position:fixed;z-index:70;left:50%;bottom:92px;width:max-content;max-width:calc(100% - 32px);padding:11px 15px;border-radius:999px;background:var(--ink);color:#fff;font-size:12px;box-shadow:0 10px 34px rgba(0,0,0,.24);transform:translateX(-50%)}\n\n.whatsapp-handoff>p:not(.micro-label){color:var(--muted);font-size:13px;line-height:1.65}\n\n.whatsapp-action{display:flex;width:100%;margin-top:18px}\n\n.whatsapp-handoff .auth-secondary{margin-top:10px}\n\n.adaptive-activity{margin-top:20px}\n\n.activity-tabs{display:grid;grid-template-columns:1fr 1fr;gap:5px;margin-bottom:22px;padding:4px;border-radius:13px;background:var(--wash)}\n\n.activity-tabs button{min-height:40px;border:0;border-radius:10px;background:transparent;color:var(--muted);font-size:11px;font-weight:800}\n\n.activity-tabs button.active{background:var(--paper);color:var(--green);box-shadow:0 3px 12px rgba(28,42,34,.08)}\n\n.activity-summary h2{margin:0 0 10px;font:700 18px Manrope}\n\n.compact-list{border-top:1px solid var(--line)}\n\n.compact-row{border-bottom:1px solid var(--line)}\n\n.compact-row.expanded{background:#f8f8f2}\n\n.row-main{display:flex;align-items:center;justify-content:space-between;gap:14px;width:100%;padding:16px 4px;border:0;background:transparent;color:var(--ink);text-align:left}\n\n.row-main strong,.row-main span{display:block}\n\n.row-main span{margin-top:4px;color:var(--muted);font-size:10px}\n\n.row-main b{white-space:nowrap;font:800 14px Manrope}\n\n.row-value{display:flex;align-items:center;gap:9px}\n\n.row-value .row-chevron{margin:0;color:var(--green);font-size:20px;line-height:1;transition:transform .18s ease}\n\n.row-value .row-chevron.open{transform:rotate(180deg)}\n\n.row-actions{display:flex;flex-wrap:wrap;gap:7px;padding:0 4px 15px}\n\n.row-actions button{padding:8px 10px;border:1px solid var(--line);border-radius:9px;background:var(--paper);color:var(--green);font-size:10px;font-weight:800}\n\n.row-actions .danger{color:var(--red)}\n\n.view-all{width:100%;padding:13px;border:0;background:transparent;color:var(--green);font-size:11px;font-weight:800}\n\n.add-missing{margin-top:16px}\n\n.activity-loading{padding:30px;text-align:center;color:var(--muted);font-size:12px}\n\n.delete-confirm{background:var(--red)}\n\n.section-error{padding:25px;border:1px solid var(--line);border-radius:18px;background:var(--paper)}\n\n.section-error h2{font:700 18px Manrope}\n\n.section-error p,.empty-copy{color:var(--muted);font-size:12px}\n\n.section-error button{padding:9px 12px;border:0;border-radius:9px}\n\n.skeleton-panel{padding:25px;border:1px solid var(--line);border-radius:20px;background:var(--paper)}\n\n.skeleton-panel i,.skeleton-panel b{display:block;border-radius:7px;background:linear-gradient(90deg,#e6e5de 25%,#f6f5ef 45%,#e6e5de 65%);background-size:300% 100%;animation:shimmer 1.4s infinite}\n\n.skeleton-panel i{width:40%;height:17px}\n\n.skeleton-panel b{height:38px;margin:18px 0}\n\n@keyframes shimmer{to{background-position:-100% 0}}\n\n.center-action{display:inline-flex;align-items:center;justify-content:center;margin-top:12px;padding:13px 20px;border:0;border-radius:11px;background:var(--green);color:#fff;font-weight:800;text-decoration:none}\n\n.center-page{min-height:100vh;display:flex;flex-direction:column;align-items:center;justify-content:center;padding:30px;text-align:center}\n\n.brand-orb{display:grid;place-items:center;width:55px;height:55px;margin-bottom:25px;border-radius:50%;background:var(--ink);color:var(--lime);font-weight:800}\n\n.center-page h1{max-width:650px;margin:18px 0 12px;font:800 clamp(28px,5vw,43px)/1.15 Manrope}\n\n.spinner{width:26px;height:26px;border:3px solid #d8ded6;border-top-color:var(--green);border-radius:50%;animation:spin .8s linear infinite}\n\n@keyframes spin{to{transform:rotate(360deg)}}\n\n.auth-page{min-height:100vh;padding:34px 20px;display:flex;flex-direction:column;align-items:center;justify-content:center}\n\n.auth-brand{display:flex;align-items:center;gap:10px;margin-bottom:26px;color:var(--ink);font:800 17px Manrope;text-decoration:none}\n\n.auth-brand>span,.auth-icon{display:grid;place-items:center;border-radius:50%;background:var(--ink);color:var(--lime)}\n\n.auth-brand>span{width:38px;height:38px}\n\n.auth-card{width:min(100%,470px);padding:36px;border:1px solid var(--line);border-radius:24px;background:var(--paper);box-shadow:var(--shadow)}\n\n.auth-card h1{margin:7px 0 13px;font:800 clamp(30px,7vw,40px)/1.12 Manrope}\n\n.auth-card>p{color:var(--muted);font-size:13px;line-height:1.6}\n\n.auth-icon{width:48px;height:48px;margin-bottom:22px}\n\n.auth-card form{margin-top:24px}\n\n.auth-card form label{display:block;margin-bottom:8px;font-size:12px;font-weight:800}\n\n.phone-field{display:flex;border:1px solid var(--line);border-radius:12px;background:#fff}\n\n.phone-field input{width:100%;padding:14px;border:0;border-radius:inherit;outline:0}\n\n.auth-primary,.auth-secondary{width:100%;min-height:47px;margin-top:12px;border-radius:11px;font-weight:800}\n\n.auth-primary{border:0;background:var(--green);color:#fff}\n\n.auth-secondary{border:1px solid var(--line);background:transparent}\n\n.auth-error{color:var(--red)!important}\n\n.privacy-copy{margin-top:20px!important;padding-top:17px;border-top:1px solid var(--line);font-size:10px!important}\n\n.security-note{display:flex;gap:10px;margin-top:14px;padding:12px;border:1px solid var(--line);border-radius:11px}\n\n.auth-footer{margin-top:18px;color:var(--muted);font-size:10px}\n\n.signed-out-notice,.generic-message{padding:11px;border-radius:9px;background:#edf3e3;color:var(--green)!important}\n\n.sent-icon{background:var(--green);color:#fff}\n\n@media(max-width:520px){.portal-topbar{padding-inline:12px}.wordmark{font-size:13px}.month-switcher input{width:108px}.story-shell{width:calc(100% - 20px);padding-top:26px}.month-card,.activity-panel{padding:18px}.month-summary{grid-template-columns:1.2fr 1fr}.month-summary>div:last-child{grid-column:1/-1}.app-heading h1{font-size:34px}.modal-backdrop{align-items:end;padding:0}.modal{max-height:92vh;border-radius:22px 22px 0 0}.bottom-nav{bottom:10px}.auth-card{padding:27px 21px}}\n\n/* Keep the disclosure control optically centered with the transaction amount. */\n\n.row-value .row-chevron{display:grid;place-items:center;width:18px;height:18px;line-height:18px;transform:translateY(-2px)}\n\n.row-value .row-chevron.open{transform:translateY(-2px) rotate(180deg)}\n\n.modal select{width:100%;padding:12px;border:1px solid var(--line);border-radius:10px;background:#fff;color:var(--ink)}\n\n.edit-options-status{margin:17px 0 0;color:var(--muted);font-size:11px}\n\n/* Finalized expense-first product architecture. */\n\n.app-shell{width:min(100% - 28px,520px);margin:0 auto;padding:30px 0 118px}\n\n.app-heading,.workspace-heading{display:flex;align-items:flex-start;justify-content:space-between;gap:18px;margin:2px 2px 25px}\n\n.workspace-heading{align-items:center}\n\n.app-heading h1,.workspace-heading h1{margin:0;font:800 clamp(31px,8vw,44px)/1.04 Manrope;letter-spacing:-.045em}\n\n.app-heading p:last-child,.workspace-heading p:last-child{margin:10px 0 0;color:var(--muted);font-size:13px;line-height:1.5}\n\n.workspace-heading .month-switcher{flex:0 0 auto}\n\n.spending-hero{display:grid;width:100%;gap:7px;padding:22px;border:1px solid #c9d7b7;border-radius:22px;background:linear-gradient(145deg,#fffefa,#e9f2d9);color:var(--ink);text-align:left;box-shadow:var(--shadow)}\n\n.spending-hero span{color:var(--green);font-size:9px;font-weight:800;letter-spacing:.13em}\n\n.spending-hero strong{font:800 clamp(30px,8vw,40px)/1 Manrope;letter-spacing:-.05em}\n\n.spending-hero strong small{font:700 15px Manrope;letter-spacing:0}\n\n.spending-hero b{color:var(--green);font-size:11px}\n\n.home-section{margin-top:28px}\n\n.home-story-list,.stories-feed{display:grid;gap:10px}\n\n.home-story,.feed-story{position:relative;display:grid;grid-template-columns:1fr auto;gap:7px;width:100%;padding:17px;border:1px solid var(--line);border-radius:17px;background:var(--paper);color:var(--ink);text-align:left}\n\n.home-story strong,.feed-story strong{font:700 16px/1.22 Manrope}\n\n.home-story b,.feed-story b{color:var(--green);font-size:12px}\n\n.home-story i,.feed-story i{grid-column:2;grid-row:1/4;align-self:center;color:var(--green);font-size:25px;font-style:normal}\n\n.story-source{display:inline-flex;justify-self:start;padding:4px 8px;border-radius:999px;background:#e7efda;color:var(--green);font-size:9px;font-weight:800}\n\n.home-story.alert .story-source,.feed-story.alert .story-source{background:#f9e2d7;color:var(--red)}\n\n.your-money-card,.cleanup-card{display:grid;grid-template-columns:auto 1fr auto;align-items:center;gap:12px;width:100%;margin-top:25px;padding:17px;border:1px solid #c9d7b7;border-radius:18px;background:linear-gradient(145deg,#fffefa,#edf4df);color:var(--ink);text-align:left}\n\n.your-money-card>span,.cleanup-card>span{display:grid;place-items:center;width:38px;height:38px;border-radius:12px;background:#e1efdd;color:var(--green);font-size:20px}\n\n.your-money-card strong,.your-money-card small,.cleanup-card strong,.cleanup-card small{display:block}\n\n.your-money-card small,.cleanup-card small{margin-top:4px;color:var(--muted);font-size:10px;line-height:1.4}\n\n.your-money-card b,.cleanup-card b{color:var(--green);font-size:11px}\n\n.cleanup-card{margin-top:11px;border-color:#d7ddcf;background:var(--paper)}\n\n.story-filters{display:flex;gap:7px;margin:-7px 0 18px;overflow:auto;padding-bottom:3px}\n\n.story-filters button{flex:0 0 auto;padding:8px 12px;border:1px solid var(--line);border-radius:999px;background:var(--paper);color:var(--muted);font-size:10px;font-weight:800}\n\n.story-filters button.active{border-color:var(--green);background:var(--green);color:#fff}\n\n.settings-card{margin-top:15px;padding:17px;border:1px solid var(--line);border-radius:19px;background:var(--paper);box-shadow:var(--shadow)}\n\n.settings-card>button{display:grid;grid-template-columns:auto 1fr auto;align-items:center;gap:12px;width:100%;padding:14px 0;border:0;border-bottom:1px solid var(--line);background:transparent;color:var(--ink);text-align:left}\n\n.settings-card>button:last-of-type{border-bottom:0}\n\n.settings-card button>span{display:grid;place-items:center;width:31px;height:31px;border-radius:10px;background:#edf3e3;color:var(--green)}\n\n.settings-card button strong,.settings-card button small{display:block}\n\n.settings-card button small{margin-top:3px;color:var(--muted);font-size:10px}\n\n.settings-card button>b{color:var(--green);font-size:10px}\n\n.settings-card label{display:flex;align-items:center;justify-content:space-between;gap:15px;padding:13px 0;border-bottom:1px solid var(--line);font-size:12px;font-weight:700}\n\n.settings-card label:last-child{border-bottom:0}\n\n.settings-card input{width:38px;height:22px;accent-color:var(--green)}\n\n.module-reassurance{margin:8px 0 18px;color:var(--muted);font-size:12px;line-height:1.55}\n\n.module-row{display:grid;grid-template-columns:auto 1fr auto;align-items:center;gap:12px;width:100%;padding:14px 0;border:0;border-top:1px solid var(--line);background:transparent;color:var(--ink);text-align:left}\n\n.module-row>span{display:grid;place-items:center;width:37px;height:37px;border-radius:11px;background:#edf3e3;color:var(--green);font-size:19px}\n\n.module-row strong,.module-row small{display:block}\n\n.module-row small{margin-top:3px;color:var(--muted);font-size:10px}\n\n.module-row b{color:var(--green);font-size:9px}\n\n.module-footnote{margin:17px 0 0;color:var(--muted);font-size:10px;line-height:1.45}\n\n.money-modal{width:min(100%,470px)}\n\n.topbar-actions{display:flex;align-items:center;gap:8px}\n\n.connection-status{display:inline-flex;align-items:center;gap:6px;padding:7px 9px;border:1px solid var(--line);border-radius:999px;background:var(--paper);color:var(--muted);font-size:9px;font-weight:800}\n\n.connection-status i{width:6px;height:6px;border-radius:50%;background:#b3b8b3}\n\n.connection-status.online{border-color:#bcd4bd;color:var(--green)}\n\n.connection-status.online i{background:#4f8f70}\n\n.connection-status.offline{border-color:#e1c8be;color:var(--red)}\n\n.connection-status.offline i{background:var(--red)}\n\n.offline-notice{display:grid;grid-template-columns:auto 1fr auto;align-items:center;gap:10px;margin:0 0 20px;padding:12px;border:1px solid #e1c8be;border-radius:14px;background:#fff7f1}\n\n.offline-notice>span{display:grid;place-items:center;width:28px;height:28px;border-radius:9px;background:#f8e2d6;color:var(--red)}\n\n.offline-notice strong,.offline-notice p{display:block}\n\n.offline-notice strong{font-size:11px}\n\n.offline-notice p{margin:3px 0 0;color:var(--muted);font-size:9px;line-height:1.35}\n\n.offline-notice button{padding:7px 9px;border:1px solid #e1c8be;border-radius:8px;background:var(--paper);color:var(--red);font-size:9px;font-weight:800}\n\n.demo-mode-toggle span{display:grid;gap:3px}\n\n.demo-mode-toggle strong,.demo-mode-toggle small{display:block}\n\n.demo-mode-toggle small{color:var(--muted);font-size:10px;font-weight:500;line-height:1.35}\n\n.demo-mode-toggle input{flex:0 0 auto}\n\n.connection-status:not(.online):not(.offline) i{animation:connection-pulse .9s ease-in-out infinite}\n\n@keyframes connection-pulse{50%{opacity:.3;transform:scale(.7)}}\n\n/* Dialogs opened from the story reader must sit above its z-index:80 backdrop. */\n\n.modal-backdrop{z-index:100}\n\n.modal-backdrop .evidence-list{max-height:55vh;overflow-y:auto;padding-right:2px}\n\n.modal-backdrop .evidence-row{align-items:flex-start}\n\n.modal-backdrop .evidence-row b{color:var(--ink);font:800 13px Manrope}\n\n.modal-backdrop .evidence-row.due-commitment{margin-inline:-8px;padding:12px 8px;border:1px solid #e4a49c;border-radius:10px;background:#fff4f1}\n\n.modal-backdrop .evidence-row.due-commitment strong,.modal-backdrop .evidence-row.due-commitment b{color:var(--red)}\n\n.modal-backdrop .evidence-row .secondary{margin-top:7px;padding:7px 9px;font-size:9px}\n\n.evidence-empty{margin-top:14px}\n\n.loans-module{margin-top:16px;padding:14px;border:1px solid #cbdcc1;border-radius:15px;background:linear-gradient(145deg,#fbfdf5,#edf4e3)}\n\n.loans-heading{display:flex;align-items:center;justify-content:space-between;gap:12px}\n\n.loans-heading strong,.loans-heading small{display:block}\n\n.loans-heading strong{font:800 15px Manrope}\n\n.loans-heading small{margin-top:3px;color:var(--muted);font-size:9px}\n\n.loan-total{text-align:right}\n\n.loan-total span,.loan-total b{display:block}\n\n.loan-total span{color:var(--muted);font-size:8px;font-weight:700}\n\n.loan-total b{margin-top:3px;color:var(--green);font:800 12px Manrope}\n\n.loan-add{display:grid;place-items:center;width:31px;height:31px;border:0;border-radius:10px;background:var(--green);color:#fff;font-size:21px;line-height:1}\n\n.loan-row{display:grid;grid-template-columns:auto minmax(0,1fr) auto;gap:9px;align-items:center;margin-top:10px;padding-top:10px;border-top:1px solid #d4e1cf}\n\n.loan-row>span{display:grid;place-items:center;width:29px;height:29px;border-radius:9px;background:#dceca7;color:var(--green);font:800 13px Manrope}\n\n.loan-row strong,.loan-row small,.loan-row b{display:block}\n\n.loan-row strong{font-size:11px}\n\n.loan-row small{margin-top:3px;color:var(--muted);font-size:8px;line-height:1.35}\n\n.loan-row>div:last-child{text-align:right}\n\n.loan-row b{color:var(--green);font:800 11px Manrope}\n\n.add-loan-row{width:100%;margin-top:11px;padding:9px;border:1px dashed #9cbc96;border-radius:10px;background:#fffefa;color:var(--green);font-size:10px;font-weight:800}\n\n.loan-form-backdrop{z-index:130}\n\n.loan-form label{display:grid;gap:7px;margin-top:13px;font-size:11px;font-weight:800}\n\n.loan-form input{width:100%;padding:11px;border:1px solid var(--line);border-radius:10px;background:#fff;color:var(--ink)}\n\n.loan-name{display:flex!important;align-items:center;gap:5px}\n\n.loan-edit{display:grid;place-items:center;width:17px;height:17px;padding:0;border:0;border-radius:5px;background:transparent;color:var(--green);font-size:10px;line-height:1;cursor:pointer}\n\n.loan-edit:hover,.loan-edit:focus-visible{background:#dceca7;outline:none}\n\n.loan-state{margin:11px 0 0;padding:10px;border-top:1px solid #d4e1cf;color:var(--muted);font-size:10px}\n\n.loan-state.error{display:flex;align-items:center;justify-content:space-between;gap:8px;color:var(--red)}\n\n.loan-state.error button{padding:5px 7px;border:1px solid #e1c8be;border-radius:7px;background:#fff;color:var(--red);font-size:9px;font-weight:800}\n\n.loan-form select{width:100%;padding:11px;border:1px solid var(--line);border-radius:10px;background:#fff;color:var(--ink)}\n\n.loan-progress{grid-column:2/-1;margin-top:-1px;padding:0 0 1px}\n\n.loan-progress>div{display:flex;align-items:center;justify-content:space-between;gap:8px;margin-bottom:5px;color:var(--muted);font-size:8px}\n\n.loan-progress b{color:var(--green);font-weight:800;text-align:right}\n\n.loan-progress i{display:block;height:4px;overflow:hidden;border-radius:99px;background:#d8e6d2}\n\n.loan-progress i::after{display:block;width:var(--loan-progress);height:100%;border-radius:inherit;background:var(--green);content:'';animation:loan-progress-in .65s ease-out both}\n\n@keyframes loan-progress-in{from{width:0}}\n\n.loan-row.due-loan{margin-inline:-6px;padding:10px 6px 6px;border:1px solid #e1bd62;border-radius:10px;background:#fff9e8}\n\n.loan-due-action{grid-column:2/-1;padding-top:3px}\n\n.loan-due-action strong{color:#6d4b00}\n\n.loan-due-action p{margin:4px 0 8px;font-size:10px;line-height:1.4}\n\n.loan-due-action button{width:100%;padding:8px;font-size:10px}\n\n.loan-row [data-testid^=\"loan-emi-\"]{display:grid;grid-template-columns:1fr auto;gap:3px 8px;grid-column:2/-1;margin-top:5px;padding:8px;border-top:1px solid #d4e1cf;background:transparent}\n\n.loan-row [data-testid^=\"loan-emi-\"] strong{font:700 10px Manrope}\n\n.loan-row [data-testid^=\"loan-emi-\"]>span{justify-self:end;color:var(--muted);font-size:8px;font-weight:800;letter-spacing:.06em}\n\n.loan-row [data-testid^=\"loan-emi-\"] small{grid-column:1/-1;margin:0;font-size:8px}\n\n.loan-row [data-testid^=\"loan-emi-\"].due{border-color:#e4a49c;background:#fff4f1;color:var(--red)}\n\n.loan-row [data-testid^=\"loan-emi-\"].due>span{color:var(--red)}\n\n.loan-row [data-testid^=\"loan-emi-\"] button{grid-column:1/-1;margin-top:4px;padding:7px;font-size:9px}\n\n.mutual-funds-module{margin-top:16px;padding:14px;border:1px solid #b9d1d5;border-radius:15px;background:linear-gradient(145deg,#f9fdfc,#e6f3f2)}\n\n.mutual-funds-module p{margin:11px 0 0;color:var(--muted);font-size:10px;line-height:1.45}\n\n.verified-pill{padding:5px 7px;border-radius:999px;background:#d8eeeb;color:#17685f;font-size:8px;font-weight:800}\n\n.add-fund-row{width:100%;margin-top:12px;padding:9px;border:1px dashed #73a9a4;border-radius:10px;background:#fffefa;color:#17685f;font-size:10px;font-weight:800}\n\n.fund-form-backdrop{z-index:140}\n\n.fund-form{width:min(100%,520px);max-height:calc(100vh - 38px);overflow-y:auto}\n\n.fund-form label{display:grid;gap:7px;margin-top:13px;font-size:11px;font-weight:800}\n\n.fund-form input,.fund-form select{width:100%;padding:11px;border:1px solid var(--line);border-radius:10px;background:#fff;color:var(--ink)}\n\n.fund-section{margin-top:19px;padding-top:17px;border-top:1px solid var(--line)}\n\n.fund-section-label{display:block;color:var(--green);font-size:9px;font-weight:800;letter-spacing:.1em}\n\n.fund-section-label em{color:var(--muted);font-size:8px;font-style:normal}\n\n.scheme-picker{position:relative}\n\n.scheme-menu{position:absolute;z-index:3;top:100%;right:0;left:0;overflow:hidden;margin-top:5px;border:1px solid #b9d1d5;border-radius:11px;background:#fffefa;box-shadow:0 12px 30px rgba(28,42,34,.14)}\n\n.scheme-menu button{display:block;width:100%;padding:10px 12px;border:0;border-bottom:1px solid var(--line);background:transparent;color:var(--ink);text-align:left}\n\n.scheme-menu button:last-child{border-bottom:0}\n\n.scheme-menu button:hover{background:#edf7f4}\n\n.scheme-menu strong,.scheme-menu small{display:block}\n\n.scheme-menu strong{font-size:10px;line-height:1.35}\n\n.scheme-menu small{margin-top:3px;color:var(--muted);font-size:8px}\n\n.scheme-menu p{margin:0;padding:12px;color:var(--muted);font-size:10px}\n\n.scheme-validated{display:flex;align-items:center;gap:8px;margin-top:9px;padding:9px;border-radius:10px;background:#e8f5ef;color:#17685f}\n\n.scheme-validated>span,.fund-success>span{display:grid;place-items:center;flex:0 0 auto;width:19px;height:19px;border-radius:50%;background:#277762;color:#fff;font-size:11px;font-weight:800}\n\n.scheme-validated strong,.scheme-validated small{display:block}\n\n.scheme-validated strong{font-size:9px}\n\n.scheme-validated small{margin-top:2px;color:#538075;font-size:8px}\n\n.fund-field-pair{display:grid;grid-template-columns:1fr 1fr;gap:10px}\n\n.fund-form fieldset{display:flex;flex-wrap:wrap;gap:8px 15px;margin:15px 0 0;padding:0;border:0}\n\n.fund-form legend{width:100%;margin-bottom:1px;font-size:11px;font-weight:800}\n\n.fund-form label.choice{display:flex;align-items:center;gap:6px;margin:0;font-size:10px;font-weight:700}\n\n.fund-form .choice input{width:15px;height:15px;margin:0;padding:0;accent-color:var(--green)}\n\n.average-cost{display:grid;grid-template-columns:1fr auto;gap:4px;margin-top:13px;padding:12px;border-radius:12px;background:#f0f5e8}\n\n.average-cost span{color:var(--muted);font-size:9px;font-weight:700}\n\n.average-cost strong{color:var(--green);font:800 15px Manrope}\n\n.average-cost strong small{font:700 9px Manrope}\n\n.average-cost b{grid-column:1/-1;color:#5d7a57;font-size:8px}\n\n.fund-disclaimer{margin:14px 0 0;color:var(--muted);font-size:8px;line-height:1.45}\n\n.fund-success{text-align:center;padding:14px 4px 5px}\n\n.fund-success>span{width:38px;height:38px;margin:0 auto 12px;font-size:18px}\n\n.fund-success .micro-label{margin-bottom:6px}\n\n.fund-success h2{margin-bottom:9px}\n\n.fund-success p:not(.micro-label){color:var(--muted);font-size:12px;line-height:1.55}\n\n.fund-success .primary{width:100%;margin-top:8px}\n\n.income-module{margin-top:16px;padding:14px;border:1px solid #e4c995;border-radius:15px;background:linear-gradient(145deg,#fffdf7,#fbf1db)}\n\n.income-summary{margin-top:11px;padding:10px;border-radius:10px;background:#fffaf0}\n\n.income-summary strong,.income-summary small{display:block}\n\n.income-summary strong{font-size:11px}\n\n.income-summary small{margin-top:4px;color:var(--muted);font-size:9px}\n\n.income-summary.masked{display:inline-grid;grid-template-columns:auto auto;align-items:center;gap:2px 8px;min-width:126px;padding:7px 10px;background:#f4e3c2}\n\n.income-summary.masked span{color:#795d2d;font-size:8px;font-weight:800;text-transform:uppercase;letter-spacing:.08em}\n\n.income-summary.masked strong{font:800 18px/1 Manrope;letter-spacing:.08em}\n\n.income-summary.masked small{grid-column:1/-1;margin:0;font-size:8px}\n\n.income-edit{display:grid;place-items:center;width:17px;height:17px;padding:0;border:0;border-radius:5px;background:transparent;color:#795d2d;font-size:10px;line-height:1;cursor:pointer}\n\n.income-edit:hover,.income-edit:focus-visible{background:#e9c982;outline:none}\n\n.income-flow-backdrop{z-index:160}\n\n.income-flow{width:min(100%,480px)}\n\n.income-flow label{display:grid;gap:7px;margin-top:13px;font-size:11px;font-weight:800}\n\n.income-flow input,.income-flow select{width:100%;padding:11px;border:1px solid var(--line);border-radius:10px;background:#fff;color:var(--ink)}\n\n.range-options{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-top:15px}\n\n.range-options button{padding:11px 8px;border:1px solid #e2c78f;border-radius:10px;background:#fffaf0;color:var(--ink);font-size:10px;font-weight:800}\n\n.range-options button.active{border-color:#a16a13;background:#f4ddb0;color:#734a0a}\n\n.income-exact-toggle{margin-top:14px}\n\n.portfolio-total{display:grid;justify-items:center;margin:15px 0 13px;padding:14px;border:1px solid #c8dfdc;border-radius:13px;background:rgba(255,255,255,.64)}\n\n.portfolio-total span{color:var(--muted);font-size:8px;font-weight:800;text-transform:uppercase;letter-spacing:.08em}\n\n.portfolio-total strong{margin-top:4px;font:800 25px/1 Manrope;letter-spacing:-.04em}\n\n.portfolio-total small{margin-top:5px;color:var(--muted);font-size:9px;font-weight:800}\n\n.positive{color:#138d62!important}\n\n.negative{color:var(--red)!important}\n\n.fund-card-list{display:grid;gap:10px}\n\n.fund-card{position:relative;overflow:hidden;padding:16px;border:1px solid #d5e1dc;border-radius:15px;background:#fffefa;box-shadow:0 6px 18px rgba(28,42,34,.05)}\n\n.fund-card::before{position:absolute;inset:0 auto 0 0;width:4px;background:#4e9d8d;content:''}\n\n.fund-card-orb{position:absolute;top:-11px;right:-9px;width:45px;height:45px;border-radius:15px;background:linear-gradient(135deg,#f36a79,#ab2347);transform:rotate(35deg)}\n\n.fund-card.gold .fund-card-orb{background:linear-gradient(135deg,#ffd45a,#e99b00)}\n\n.fund-card.violet .fund-card-orb{background:linear-gradient(135deg,#bb8af8,#6e4bb8)}\n\n.fund-card.blue .fund-card-orb{background:linear-gradient(135deg,#74b8ff,#2777be)}\n\n.fund-card-title{padding-right:32px}\n\n.fund-card-title strong,.fund-card-title small{display:block}\n\n.fund-card-title strong{font:800 12px/1.35 Manrope}\n\n.fund-card-title small{margin-top:5px;color:var(--muted);font-size:9px}\n\n.fund-card-values{display:grid;grid-template-columns:1.05fr .95fr .95fr;gap:8px;margin-top:15px;padding:13px 0;border-block:1px solid #e1e6df}\n\n.fund-card-values span,.fund-card-values b,.fund-card-values small{display:block}\n\n.fund-card-values span{color:var(--muted);font-size:8px}\n\n.fund-card-values b{margin-top:4px;font:800 12px Manrope;letter-spacing:-.025em}\n\n.fund-card-values small{margin-top:3px;font-size:9px;font-weight:800}\n\n.fund-card-nav{margin:9px 0 0;color:var(--muted);font-size:8px}\n\n.fund-card footer{margin-top:12px;color:var(--muted);font-size:9px}\n\n.fund-valuation-unavailable{margin:14px 0 0;padding:9px;border-radius:8px;background:#f5eee9;color:var(--muted);font-size:8px;line-height:1.45;text-align:center}\n\n.fund-card{width:100%;color:var(--ink);text-align:left;cursor:pointer}\n\n.fund-card:hover{border-color:#8dbbb2;transform:translateY(-1px)}\n\n.fund-card footer{display:flex;justify-content:space-between;gap:8px}\n\n.fund-card footer span{color:var(--green);font-weight:800;white-space:nowrap}\n\n.fund-detail{width:min(100%,420px)}\n\n.fund-detail h2{padding-right:20px;font-size:21px;line-height:1.25}\n\n.detail-value{margin-top:19px;padding:16px;border-radius:14px;background:linear-gradient(145deg,#edf5e6,#fffefa)}\n\n.detail-value span,.detail-value strong{display:block}\n\n.detail-value span,.detail-pnl span,.detail-grid span{color:var(--muted);font-size:9px;font-weight:800}\n\n.detail-value strong{margin-top:5px;font:800 29px/1 Manrope;letter-spacing:-.05em}\n\n.detail-pnl{display:flex;align-items:baseline;gap:8px;margin-top:14px}\n\n.detail-pnl strong{font:800 17px Manrope}\n\n.detail-pnl b{font-size:11px}\n\n.detail-grid{display:grid;grid-template-columns:1fr 1fr;gap:1px;margin-top:18px;overflow:hidden;border:1px solid var(--line);border-radius:13px;background:var(--line)}\n\n.detail-grid>div{padding:12px;background:var(--paper)}\n\n.detail-grid span,.detail-grid b{display:block}\n\n.detail-grid b{margin-top:5px;font:800 12px Manrope}\n\n.due-sip{margin-top:7px;padding:5px 7px;border:1px solid #89b4ad;border-radius:7px;background:#fffefa;color:#17685f;font-size:8px;font-weight:800}\n\n.action-queue-loading{color:var(--muted);font-size:11px}\n\n.action-card-list{display:grid;gap:10px}\n\n.action-card{display:grid;grid-template-columns:auto 1fr;gap:12px;padding:16px;border:1px solid #c9d7b7;border-radius:17px;background:linear-gradient(145deg,#fffefa,#edf4df);box-shadow:var(--shadow)}\n\n.action-icon{display:grid;place-items:center;width:34px;height:34px;border-radius:11px;background:var(--green);color:#fff;font:800 18px Manrope}\n\n.action-card strong{display:block;font:800 14px Manrope}\n\n.action-card p{margin:5px 0 0;color:var(--muted);font-size:11px;line-height:1.45}\n\n.action-complete{margin-top:13px;padding:9px 12px;font-size:10px}\n\n.action-complete:disabled{cursor:wait;opacity:.7}\n\n/* Story feed: cards are browsed as a deck, with the next card intentionally peeking in. */\n\n.story-carousel{margin:14px -2px 0}\n\n.story-dots{display:flex;align-items:center;gap:7px;margin:0 0 12px 4px}\n\n.story-dots button{width:7px;height:7px;padding:0;border:0;border-radius:999px;background:#cbd4c7;transition:width .2s ease,background .2s ease;cursor:pointer}\n\n.story-dots button.active{width:22px;background:var(--green)}\n\n.story-dots span{margin-left:3px;color:var(--muted);font-size:10px;font-weight:800}\n\n.story-carousel-viewport{overflow:hidden;padding:4px 14% 14px 2px;touch-action:pan-y}\n\n.story-carousel-track{display:flex;gap:12px;transition:transform .28s cubic-bezier(.2,.8,.2,1)}\n\n.story-carousel-card{position:relative;display:grid;grid-template-columns:1fr auto;flex:0 0 100%;min-height:156px;gap:9px;padding:20px;border:1px solid #c9d7b7;border-radius:21px;background:linear-gradient(145deg,#fffefa,#edf4df);color:var(--ink);text-align:left;box-shadow:0 11px 25px rgba(37,76,44,.09);transition:opacity .28s ease,transform .28s ease}\n\n.story-carousel-card::before,.story-carousel-card::after{position:absolute;z-index:-1;inset:8px -5px -8px 7px;border:1px solid #dce7d4;border-radius:21px;background:#f4f7ee;content:'';transform:rotate(1.4deg)}\n\n.story-carousel-card::after{z-index:-2;inset:14px -9px -14px 13px;background:#e9f0e5;transform:rotate(2.8deg)}\n\n.story-carousel-card:not(.current){opacity:.72;transform:scale(.97)}\n\n.story-carousel-card strong{align-self:end;font:800 clamp(20px,5.2vw,25px)/1.12 Manrope;letter-spacing:-.04em}\n\n.story-carousel-card b{align-self:start;color:var(--green);font-size:13px}\n\n.story-carousel-card i{grid-column:2;grid-row:1/4;align-self:center;color:var(--green);font-size:29px;font-style:normal}\n\n.story-carousel-card.alert{border-color:#e4c3b4;background:linear-gradient(145deg,#fff7f0,#f7e1d5)}\n\n.story-carousel-card.alert .story-source{background:#f9e2d7;color:var(--red)}\n\n.story-carousel-full{margin-top:4px}\n\n.story-carousel-full .story-carousel-card{min-height:220px;padding:27px}\n\n.account-repair-launcher{position:fixed;z-index:35;right:max(22px,env(safe-area-inset-right));bottom:max(22px,env(safe-area-inset-bottom));display:flex;align-items:center;gap:11px;padding:10px 15px 10px 11px;border:1px solid rgba(255,255,255,.2);border-radius:17px;background:var(--ink);color:#fff;text-align:left;box-shadow:0 14px 36px rgba(15,30,21,.3);cursor:pointer}\n\n.account-repair-launcher svg{width:27px;height:27px;padding:5px;border-radius:9px;background:var(--lime);fill:var(--ink)}\n\n.account-repair-launcher strong,.account-repair-launcher small{display:block}\n\n.account-repair-launcher strong{font:800 11px Manrope}\n\n.account-repair-launcher small{margin-top:2px;color:#cbd7cf;font-size:8px}\n\n.account-repair-launcher:hover{transform:translateY(-2px);box-shadow:0 17px 42px rgba(15,30,21,.36)}\n\n.account-repair-backdrop{position:fixed;inset:0;z-index:80;display:grid;place-items:center;padding:22px;background:rgba(18,29,22,.64);backdrop-filter:blur(7px)}\n\n.account-repair-dialog{display:flex;flex-direction:column;width:min(100%,760px);max-height:calc(100vh - 44px);overflow:hidden;border:1px solid rgba(255,255,255,.35);border-radius:25px;background:var(--paper);box-shadow:0 32px 110px rgba(8,18,12,.5)}\n\n.account-repair-bar{display:flex;align-items:center;justify-content:space-between;flex:0 0 auto;padding:14px 17px;border-bottom:1px solid var(--line);background:#f5f6ee}\n\n.account-repair-bar>div{display:flex;align-items:center;gap:10px}\n\n.repair-symbol{display:grid;place-items:center;width:34px;height:34px;border-radius:11px;background:var(--ink);color:var(--lime);font-size:19px;transform:rotate(-35deg)}\n\n.account-repair-bar p{margin:0;color:var(--green);font-size:8px;font-weight:800;letter-spacing:.11em}\n\n.account-repair-bar strong{display:block;margin-top:2px;font:800 13px Manrope}\n\n.account-repair-bar button{display:grid;place-items:center;width:34px;height:34px;border:0;border-radius:50%;background:#e7e8df;color:var(--muted);font-size:23px;cursor:pointer}\n\n.account-repair-content{padding:25px;overflow-y:auto}\n\n.account-repair-content .normalization-page{max-width:680px;margin:auto}\n\n.normalization-heading{display:flex;align-items:flex-start;justify-content:space-between;gap:18px;margin:2px 2px 24px}\n\n.normalization-heading h1{margin:0;font:800 clamp(31px,8vw,44px)/1.04 Manrope;letter-spacing:-.045em}\n\n.normalization-heading p:last-child{max-width:370px;margin:10px 0 0;color:var(--muted);font-size:13px;line-height:1.5}\n\n.add-normalization{display:grid;place-items:center;flex:0 0 auto;width:44px;height:44px;border:0;border-radius:50%;background:var(--green);color:#fff;font-size:24px;line-height:1;box-shadow:0 8px 20px rgba(34,104,79,.22)}\n\n.merge-workspace{margin:0 0 28px;padding:20px;border:1px solid #c8d8c1;border-radius:22px;background:linear-gradient(145deg,#fbfdf5,#edf4e3);box-shadow:0 12px 34px rgba(41,77,51,.07)}\n\n.merge-title-row{display:flex;align-items:flex-start;justify-content:space-between;gap:12px}\n\n.merge-title-row h2,.saved-preferences-heading h2{margin:0;font:700 19px Manrope}\n\n.merge-title-row p:not(.micro-label){max-width:360px;margin:7px 0 0;color:var(--muted);font-size:11px;line-height:1.5}\n\n.merge-count{flex:0 0 auto;margin-top:2px;padding:6px 8px;border:1px solid #c8d8c1;border-radius:999px;background:rgba(255,255,255,.72);color:var(--green);font-size:9px;font-weight:800}\n\n.merge-layout{display:grid;grid-template-columns:minmax(0,.88fr) minmax(0,1.12fr);gap:13px;margin-top:18px}\n\n.merge-candidate-list{display:grid;align-content:start;gap:8px}\n\n.merge-candidate{display:grid;grid-template-columns:auto minmax(0,1fr) auto;gap:9px;align-items:center;width:100%;padding:11px;border:1px solid #d8dfd1;border-radius:13px;background:rgba(255,255,255,.66);color:var(--ink);text-align:left}\n\n.merge-candidate.active{border-color:#87ad7e;background:#fffefa;box-shadow:0 5px 14px rgba(45,85,56,.09)}\n\n.candidate-stack{display:flex;width:29px}\n\n.candidate-stack i{display:grid;place-items:center;width:21px;height:21px;margin-right:-7px;border:2px solid #f8fbf1;border-radius:8px;background:#dceca7;color:var(--green);font:800 9px Manrope;font-style:normal}\n\n.candidate-stack i:nth-child(2){background:#d5e8dd}\n\n.merge-candidate strong,.merge-candidate small{display:block}\n\n.merge-candidate strong{overflow:hidden;font:700 10px/1.3 Manrope;text-overflow:ellipsis;white-space:nowrap}\n\n.merge-candidate small{margin-top:4px;color:var(--muted);font-size:9px}\n\n.candidate-arrow{color:var(--green);font-size:21px}\n\n.merge-review{padding:14px;border:1px solid #d2dfc9;border-radius:15px;background:#fffefa}\n\n.merge-review-heading{display:flex;align-items:center;gap:8px}\n\n.merge-spark{display:grid;place-items:center;width:27px;height:27px;border-radius:9px;background:#e4efdf;color:var(--green);font-size:13px}\n\n.merge-review-heading strong,.merge-review-heading small{display:block}\n\n.merge-review-heading strong{font:700 10px Manrope}\n\n.merge-review-heading small{margin-top:2px;color:var(--muted);font-size:8px}\n\n.merge-instruction{margin:13px 0 8px;font-size:11px;font-weight:800}\n\n.merge-label-options{display:grid;gap:5px}\n\n.merge-label-options button{display:grid;grid-template-columns:auto 1fr auto;gap:8px;align-items:center;width:100%;padding:7px;border:1px solid transparent;border-radius:9px;background:transparent;color:var(--ink);text-align:left}\n\n.merge-label-options button.selected{border-color:#b4cfa9;background:#f1f7e8}\n\n.merge-label-icon{display:grid;place-items:center;width:23px;height:23px;border-radius:7px;background:#edf0e9;color:#5d6e5f;font:800 9px Manrope}\n\n.merge-label-options strong,.merge-label-options small{display:block}\n\n.merge-label-options strong{font-size:10px}\n\n.merge-label-options small{margin-top:2px;color:var(--muted);font-size:8px}\n\n.radio-dot{width:14px;height:14px;border:1px solid #b5bdb3;border-radius:50%}\n\n.selected .radio-dot{border:4px solid var(--green);background:#fff}\n\n.merge-button{width:100%;margin-top:12px;padding:10px;border:0;border-radius:10px;background:var(--green);color:#fff;font-size:10px;font-weight:800}\n\n.merge-footnote{margin:8px 0 0;color:var(--muted);font-size:8px;line-height:1.4;text-align:center}\n\n.merge-success{margin:9px 0 0;padding:8px;border-radius:8px;background:#e7f1dd;color:var(--green);font-size:9px;font-weight:700}\n\n.saved-preferences-heading{margin:0 2px 11px}\n\n.saved-preferences-heading .micro-label{margin-bottom:5px}\n\n.merchant-selection{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-top:17px}\n\n.merchant-option{display:grid;grid-template-columns:auto auto 1fr;gap:9px;align-items:center;min-height:57px;padding:10px;border:1px solid #d8dfd1;border-radius:12px;background:rgba(255,255,255,.66);cursor:pointer}\n\n.merchant-option.selected{border-color:#87ad7e;background:#fffefa;box-shadow:0 4px 12px rgba(45,85,56,.07)}\n\n.merchant-option.blocked{cursor:not-allowed;opacity:.48}\n\n.merchant-option input{width:16px;height:16px;margin:0;accent-color:var(--green)}\n\n.merchant-option strong,.merchant-option small{display:block}\n\n.merchant-option strong{font:700 11px Manrope}\n\n.merchant-option small{margin-top:3px;color:var(--muted);font-size:9px}\n\n.merge-selection-footer{display:flex;align-items:center;justify-content:space-between;gap:13px;margin-top:13px;padding-top:13px;border-top:1px solid #d5e0cf}\n\n.merge-selection-footer>span{color:var(--muted);font-size:10px}\n\n.merge-selection-footer .merge-button{width:auto;margin:0;padding-inline:14px;white-space:nowrap}\n\n.merge-type-note{margin:9px 0 0;color:var(--green);font-size:9px;line-height:1.45}\n\n.merge-modal-copy{margin:0 0 16px;color:var(--muted);font-size:12px;line-height:1.55}\n\n.merge-name-field{display:grid;gap:7px;font-size:12px;font-weight:800}\n\n.merge-name-field input{width:100%;padding:12px;border:1px solid var(--line);border-radius:10px;background:#fff;color:var(--ink)}\n\n.merge-modal-selected{margin-top:14px;padding:11px 12px;border-radius:10px;background:var(--wash)}\n\n.merge-modal-selected span{display:block;color:var(--muted);font-size:9px;font-weight:800;text-transform:uppercase;letter-spacing:.08em}\n\n.merge-modal-selected p{margin:5px 0 0;font-size:11px;line-height:1.5}\n\n.normalization-tabs{display:grid;grid-template-columns:1fr 1fr;gap:6px;margin-bottom:14px;padding:5px;border-radius:14px;background:#e9e8e1}\n\n.normalization-tabs button{min-height:43px;border:0;border-radius:10px;background:transparent;color:var(--muted);font-size:12px;font-weight:800}\n\n.normalization-tabs button span{display:inline-grid;place-items:center;min-width:20px;height:20px;margin-left:5px;padding:0 5px;border-radius:999px;background:rgba(30,40,34,.08);font-size:9px}\n\n.normalization-tabs but