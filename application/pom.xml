<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.apps.deen-sa</groupId><artifactId>personal-ai-parent</artifactId>
        <version>0.0.1-SNAPSHOT</version><relativePath>../pom.xml</relativePath>
    </parent>
    <artifactId>personal-ai-application</artifactId>
    <name>personal-ai-application</name>
    <description>Conversational operations modular monolith</description>
    <dependencies>
        <dependency><groupId>com.apps.deen-sa</groupId><artifactId>extension-api</artifactId></dependency>
        <dependency><groupId>com.apps.deen-sa</groupId><artifactId>platform-core</artifactId></dependency>
        <dependency><groupId>com.apps.deen-sa</groupId><artifactId>platform-conversation</artifactId></dependency>
        <dependency><groupId>com.apps.deen-sa</groupId><artifactId>adapter-openai</artifactId></dependency>
        <dependency><groupId>com.apps.deen-sa</groupId><artifactId>adapter-whatsapp</artifactId></dependency>
        <dependency><groupId>com.apps.deen-sa</groupId><artifactId>adapter-postgres</artifactId></dependency>
        <dependency><groupId>com.apps.deen-sa</groupId><artifactId>extension-personal-finance</artifactId></dependency>
        <dependency><groupId>com.apps.deen-sa</groupId><artifactId>extension-saree-job-work</artifactId></dependency>
        <dependency><groupId>com.apps.deen-sa</groupId><artifactId>extension-grocery</artifactId></dependency>
        <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter</artifactId></dependency>
        <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-web</artifactId></dependency>
        <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-webflux</artifactId></dependency>
        <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-data-jpa</artifactId></dependency>
        <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-actuator</artifactId></dependency>
        <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-test</artifactId><scope>test</scope></dependency>
        <dependency><groupId>org.testcontainers</groupId><artifactId>junit-jupiter</artifactId><scope>test</scope></dependency>
        <dependency><groupId>org.testcontainers</groupId><artifactId>postgresql</artifactId><scope>test</scope></dependency>
        <dependency><groupId>org.postgresql</groupId><artifactId>postgresql</artifactId><scope>runtime</scope></dependency>
        <dependency><groupId>org.projectlombok</groupId><artifactId>lombok</artifactId><optional>true</optional></dependency>
        <dependency><groupId>com.fasterxml.jackson.datatype</groupId><artifactId>jackson-datatype-jsr310</artifactId></dependency>
        <dependency><groupId>org.flywaydb</groupId><artifactId>flyway-core</artifactId></dependency>
        <dependency><groupId>com.openai</groupId><artifactId>openai-java</artifactId><version>4.6.1</version></dependency>
        <dependency><groupId>com.tngtech.archunit</groupId><artifactId>archunit-junit5</artifactId><version>1.3.0</version><scope>test</scope></dependency>
    </dependencies>
    <build>
        <sourceDirectory>${project.basedir}/../src/main/java</sourceDirectory>
        <testSourceDirectory>${project.basedir}/../src/test/java</testSourceDirectory>
        <resources><resource><directory>${project.basedir}/../src/main/resources</directory>
            <excludes><exclude>db/migration/**</exclude></excludes>
        </resource></resources>
        <testResources><testResource><directory>${project.basedir}/../src/test/resources</directory></testResource></testResources>
        <plugins>
            <plugin><groupId>org.springframework.boot</groupId><artifactId>spring-boot-maven-plugin</artifactId>
                <configuration><excludes><exclude><groupId>org.projectlombok</groupId><artifactId>lombok</artifactId></exclude></excludes></configuration>
            </plugin>
            <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-compiler-plugin</artifactId>
                <configuration><release>21</release>
                    <excludes>
                        <exclude>com/apps/deen_sa/finance/**</exclude>
                        <exclude>com/apps/deen_sa/core/state/**</exclude>
                        <exclude>com/apps/deen_sa/core/mutation/**</exclude>
                        <exclude>com/apps/deen_sa/llm/impl/**</exclude>
                        <exclude>com/apps/deen_sa/llm/AiCallTelemetry.java</exclude>
                        <exclude>com/apps/deen_sa/llm/BaseLLMExtractor.java</exclude>
                        <exclude>com/apps/deen_sa/llm/PromptLoader.java</exclude>
                        <exclude>com/apps/deen_sa/config/ApplicationProperties.java</exclude>
                        <exclude>com/apps/deen_sa/common/exception/LLMParsingException.java</exclude>
                        <exclude>com/apps/deen_sa/conversation/ConversationContext.java</exclude>
                        <exclude>com/apps/deen_sa/conversation/ConversationChannelGateway.java</exclude>
                        <exclude>com/apps/deen_sa/conversation/AudioTranscriber.java</exclude>
                        <exclude>com/apps/deen_sa/conversation/AudioHandler.java</exclude>
                        <exclude>com/apps/deen_sa/conversation/WhatsApp*.java</exclude>
                        <exclude>com/apps/deen_sa/conversation/InboundMessage*.java</exclude>
                        <exclude>com/apps/deen_sa/conversation/AudioConfirmation*.java</exclude>
                        <exclude>com/apps/deen_sa/conversation/AppUser*.java</exclude>
                        <exclude>com/apps/deen_sa/conversation/ConversationSession*.java</exclude>
                        <exclude>com/apps/deen_sa/conversation/ConversationMessages.java</exclude>
                        <exclude>com/apps/deen_sa/conversation/ResponseAction.java</exclude>
                        <exclude>com/apps/deen_sa/conversation/SpeechHandler.java</exclude>
                        <exclude>com/apps/deen_sa/conversation/SpeechResult.java</exclude>
                        <exclude>com/apps/deen_sa/conversation/SpeechStatus.java</exclude>
                        <exclude>com/apps/deen_sa/conversation/interpretation/ConversationInterpretationException.java</exclude>
                        <exclude>com/apps/deen_sa/conversation/interpretation/ConversationInterpreter.java</exclude>
                        <exclude>com/apps/deen_sa/conversation/interpretation/ConversationTurn.java</exclude>
                        <exclude>com/apps/deen_sa/conversation/interpretation/EventFields.java</exclude>
                        <exclude>com/apps/deen_sa/conversation/interpretation/EventPatch.java</exclude>
                        <exclude>com/apps/deen_sa/conversation/interpretation/FieldEvidence.java</exclude>
                        <exclude>com/apps/deen_sa/conversation/interpretation/InterpretationContext.java</exclude>
                        <exclude>com/apps/deen_sa/conversation/interpretation/MutationAuthorizationPolicy.java</exclude>
                        <exclude>com/apps/deen_sa/conversation/interpretation/PendingEvent.java</exclude>
                        <exclude>com/apps/deen_sa/conversation/interpretation/QueryPeriod.java</exclude>
                        <exclude>com/apps/deen_sa/conversation/interpretation/StructuredEventHandler.java</exclude>
                        <exclude>com/apps/deen_sa/conversation/interpretation/TurnInterpretation.java</exclude>
                        <exclude>com/apps/deen_sa/conversation/interpretation/TurnType.java</exclude>
                        <exclude>com/apps/deen_sa/conversation/interpretation/UnifiedConversationEngine.java</exclude>
                        <exclude>com/apps/deen_sa/conversation/interpretation/OpenAiConversationInterpreter.java</exclude>
                        <exclude>com/apps/deen_sa/dto/AccountSetupDto.java</exclude>
                        <exclude>com/apps/deen_sa/dto/Asset*.java</exclude>
                        <exclude>com/apps/deen_sa/dto/Expense*.java</exclude>
                        <exclude>com/apps/deen_sa/dto/LiabilityPaymentDto.java</exclude>
                        <exclude>com/apps/deen_sa/dto/PortfolioSummaryDto.java</exclude>
                        <exclude>com/apps/deen_sa/dto/QueryResult.java</exclude>
                        <exclude>com/apps/deen_sa/dto/SpendQuery.java</exclude>
                        <exclude>com/apps/deen_sa/dto/StateMutationCommand.java</exclude>
                        <exclude>com/apps/deen_sa/dto/TagMatchResult.java</exclude>
                        <exclude>com/apps/deen_sa/dto/TimeRange.java</exclude>
                        <exclude>com/apps/deen_sa/dto/WhatsAppWebhookPayload.java</exclude>
                        <exclude>com/apps/deen_sa/dto/UserMessage.java</exclude>
                        <exclude>com/apps/deen_sa/dto/IntentResult.java</exclude>
                    </excludes>
                    <annotationProcessorPaths>
                    <path><groupId>org.projectlombok</groupId><artifactId>lombok</artifactId><version>1.18.34</version></path>
                </annotationProcessorPaths></configuration>
            </plugin>
            <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-surefire-plugin</artifactId><version>3.1.2</version>
                <configuration><argLine>--enable-preview</argLine></configuration>
            </plugin>
        </plugins>
    </build>
    <profiles>
        <profile><id>integration</id><build><plugins><plugin>
            <groupId>org.apache.maven.plugins</groupId><artifactId>maven-failsafe-plugin</artifactId><version>3.1.2</version>
            <executions><execution><goals><goal>integration-test</goal><goal>verify</goal></goals></execution></executions>
            <configuration><includes><include>**/*IT.java</include></includes><argLine>--enable-preview</argLine></configuration>
        </plugin></plugins></build></profile>
    </profiles>
</project>
